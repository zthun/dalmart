{
  "name": "@zthun/dalmart",
  "description": "Access databases through a single common interfaces.",
  "author": "Anthony Bonta",
  "license": "MIT",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/zthun/dalmart"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "clean": "rimraf --glob 'dist' 'reports' 'coverage' '*.tgz' '*.log' 'packages/**/dist' 'packages/**/docs' 'packages/**/*.tgz' 'packages/**/*.log'",
    "check": "tsc --noEmit",
    "test": "vitest --run --coverage",
    "lint": "lint-janitor",
    "pretty": "prettier packages --fix",
    "build": "lerna run build",
    "make": "yarn clean && yarn check && yarn lint && yarn test && yarn build",
    "postinstall": "husky install"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@types/jsdom": "^21.1.7",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^22.10.5",
    "@vitest/coverage-istanbul": "^2.1.8",
    "@zthun/lint-janitor": "^18.0.6",
    "@zthun/lint-janitor-config": "^18.0.6",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "lerna": "^8.1.9",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "~5.7.2",
    "vite": "^5.4.11",
    "vite-plugin-dts": "^4.4.0",
    "vite-plugin-external": "^4.3.1",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^2.1.8"
  },
  "packageManager": "yarn@4.6.0",
  "dependencies": {
    "prettier": "^3.4.2"
  }
}
